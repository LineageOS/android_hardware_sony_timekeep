cc_binary {
    name: "timekeep",
    srcs: ["timekeep.c"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    init_rc: ["timekeep.rc"],
    owner: "sony",
    proprietary: true,
}

android_app {
    name: "TimeKeep",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    sdk_version: "current",
    static_libs: ["TimeKeepProperties"],
    proprietary: true,
    required: ["timekeep"],
}
